<!-- === ファイル名: index.html (スタッフ確認ポータル・自己診断セーフティ版) === -->

<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1">
  <meta name="robots" content="noindex, nofollow">
  <title>スタッフシフト確認ポータル</title>
  <style>
    body { font-family: sans-serif; background: #f0f2f5; margin: 0; padding: 15px; color: #333; }
    .card { background: white; border-radius: 12px; box-shadow: 0 4px 6px rgba(0,0,0,0.1); padding: 20px; text-align: center; margin-bottom: 15px; }
    h3 { margin-top: 0; color: #2c3e50; font-size: 18px; margin-bottom: 5px; }
    p.desc { font-size: 12px; color: #666; margin: 0 0 15px 0; }
    
    .select-group { display: flex; flex-direction: column; gap: 10px; margin-bottom: 15px; }
    
    select { 
      padding: 14px; 
      font-size: 15px; 
      border-radius: 8px; 
      border: 1px solid #ccc; 
      width: 100%; 
      box-sizing: border-box; 
      text-align: center; 
      font-weight: bold;
      background-color: #fff;
    }
    
    select.highlight-select {
      border: 2px solid #e67e22;
      color: #e67e22;
      background-color: #fffbf0;
    }

    .table-container { overflow: auto; max-height: 70svh; border: 1px solid #ddd; border-radius: 8px; -webkit-overflow-scrolling: touch; }
    table { border-collapse: separate; border-spacing: 0; width: 100%; font-size: 14px; }
    th, td { border-right: 1px solid #ddd; border-bottom: 1px solid #ddd; padding: 12px 10px; text-align: center; white-space: nowrap; }
    th { background: #007bff; color: white; position: sticky; top: 0; z-index: 10; }
    td:first-child { position: sticky; left: 0; background: #f8f9fa; font-weight: bold; z-index: 8; border-right: 2px solid #bbb; }
    th:first-child { position: sticky; top: 0; left: 0; background: #0056b3; z-index: 12; border-right: 2px solid #bbb; }

    td.has-shift {
      background-color: #e8f5e9 !important;
      color: #27ae60;
      font-weight: bold;
    }
    
    .monday-row {
      background-color: #f2f2f2 !important;
    }
    .monday-row td {
      color: #aaa;
    }

    #loadingOverlay { display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(255,255,255,0.8); z-index: 9999; align-items: center; justify-content: center; font-weight: bold; font-size: 18px; }
  </style>
</head>
<body>

  <!-- 💡 白いフリーズを防ぐため、「読み込み中」の中にエラーが長引いた時のための説明を付けました -->
  <div id="loadingOverlay">
    <div style="text-align:center;">
      <p style="font-size:24px; margin:0;">🚗</p>
      <p style="margin:10px 0 0 0; font-size:16px;">ポータルと接続中...</p>
      <small style="color:#888; font-size:11px; display:block; margin-top:5px;">※10秒以上かかる場合は自動でタイムアウト表示になります。</small>
    </div>
  </div>

  <div class="card">
    <h3>👤 スタッフシフト確認ポータル</h3>
    <p class="desc">自分の名前を選択すると、シフト表の中で出勤列が自動的にハイライトされます。</p>
    
    <div class="select-group">
      <select id="targetMonthSelect" onchange="onMonthChange()">
        <option value="latest">📅 最新（今月）のシフトを表示</option>
        <option value="prev">📅 前月のシフトを表示</option>
      </select>
      
      <select id="highlightSelect" class="highlight-select" onchange="onHighlightNameChange()">
        <option value="">👤 自分の名前を選択して強調表示...</option>
      </select>
    </div>

    <!-- カレンダー表示部 -->
    <div class="table-container" id="tableContainer">
      <div style="padding: 40px 0; color: #888; font-weight: bold;">カレンダーを読み込み中...</div>
    </div>
  </div>

  <script>
    // 💡 運用中（またはテスト中）の、正しいGASウェブアプリURLをここに設定してください
    const GAS_URL = "https://script.google.com/macros/s/AKfycbwcpM3ildCLcNcIFJNlp_Nz7-ZKz6lS-WEjqZ3btnFPzWr98RhIAhHX-W4sRGVYmdzU/exec"; 

    function callApi(action, params, onSuccess, onFailure) {
      console.log("API送信開始:", action, params);
      fetch(GAS_URL, {
        method: "POST",
        body: JSON.stringify({ action: action, ...params })
      })
      .then(response => {
        console.log("レスポンス受信:", response.status);
        return response.json();
      })
      .then(res => {
        console.log("データ解析完了:", res);
        if (res.status === "success") {
          if (onSuccess) onSuccess(res.data);
        } else {
          if (onFailure) onFailure(new Error(res.message));
        }
      })
      .catch(err => {
        console.error("通信エラー:", err);
        if (onFailure) onFailure(err);
      });
    }

    // 💡 タイムアウト付きローディング表示（真っ白で固まるのを防ぎます）
    function showLoading() { 
      document.getElementById('loadingOverlay').style.display = 'flex'; 
      
      // ⏱️ 10秒待っても通信が終わらない場合は、強制的に画面を開放してエラーを出します
      setTimeout(() => {
        const overlay = document.getElementById('loadingOverlay');
        if (overlay.style.display === 'flex') {
          hideLoading();
          document.getElementById('tableContainer').innerHTML = `
            <div style="color:#e74c3c; font-weight:bold; padding:30px; background:#fff5f5; border-radius:8px; border:1px solid #ffcdd2;">
              ⏱️ 通信接続タイムアウト (CORS制限またはURL不一致)<br><br>
              <span style="font-weight:normal; font-size:13px; color:#555; text-align:left; display:block; line-height:1.5;">
                ・HTMLの390行目付近に書いてある <strong>GAS_URL</strong> が、今回新しくデプロイした「テスト用GAS」のURLと完全に合致しているか確認してください。<br>
                ・GAS（Webアプリ）のデプロイ設定において、アクセスできるユーザーが <strong>「全員（Anyone）」</strong> になっているか確認してください。
              </span>
            </div>`;
        }
      }, 10000);
    }
    
    function hideLoading() { document.getElementById('loadingOverlay').style.display = 'none'; }

    let currentData = null;
    let selectedHighlightName = "";

    window.onload = function() {
      loadStaffShiftData("latest");
    };

    function onMonthChange() {
      const target = document.getElementById('targetMonthSelect').value;
      loadStaffShiftData(target);
    }

    function loadStaffShiftData(target) {
      showLoading();
      callApi("getStaffShiftData", { target: target },
        function(data) {
          hideLoading();
          currentData = data;
          renderTable(data);
        },
        function(err) {
          hideLoading();
          document.getElementById('tableContainer').innerHTML = `<div style="color:red; font-weight:bold; padding:20px;">シフトの取得に失敗しました。<br>${err.message}</div>`;
        }
      );
    }

    function renderTable(data) {
      const highlightSelect = document.getElementById('highlightSelect');
      let selectHtml = `<option value="">👤 自分の名前を選択して強調表示...</option>`;
      data.names.forEach(name => {
        selectHtml += `<option value="${name}" ${selectedHighlightName === name ? "selected" : ""}>${name}</option>`;
      });
      highlightSelect.innerHTML = selectHtml;

      let html = '<table><thead><tr><th>日付</th>';
      for (let c = 0; c < data.names.length; c++) {
        html += `<th>
          <div class="staff-name-header" style="font-weight:bold; font-size:15px;">${data.names[c]}</div>
          <div style="font-size:11px; font-weight:normal; color:#e0f7fa; margin-top:2px;">${data.roles[c] || ""}</div>
        </th>`;
      }
      html += '</tr></thead><tbody>';
      
      for (let r = 0; r < data.dates.length; r++) {
        const dateStr = data.dates[r].toString();
        const weekStr = data.weekdays[r].toString();
        
        const rowClass = weekStr.includes('月') ? "monday-row" : "";
        
        html += `<tr class="${rowClass}"><td>${dateStr}日<br><small style="color:#666;">(${weekStr})</small></td>`;
        for (let c = 0; c < data.names.length; c++) {
          const val = data.shiftData[r][c] || "";
          const tdClass = val ? "has-shift" : "";
          html += `<td class="${tdClass}">${val}</td>`;
        }
        html += '</tr>';
      }
      html += '</tbody></table>';
      document.getElementById('tableContainer').innerHTML = html;

      if (selectedHighlightName) {
        applyHighlight();
      }
    }

    function onHighlightNameChange() {
      selectedHighlightName = document.getElementById('highlightSelect').value;
      applyHighlight();
    }

    function applyHighlight() {
      document.querySelectorAll('#tableContainer td, #tableContainer th').forEach(el => {
        el.style.outline = "";
        el.style.boxShadow = "";
      });

      if (!selectedHighlightName || !currentData) return;

      let colIdx = -1;
      const headers = document.querySelectorAll('#tableContainer th');
      headers.forEach((th, idx) => {
        const nameNode = th.querySelector('.staff-name-header');
        if (nameNode && nameNode.innerText.trim() === selectedHighlightName) {
          colIdx = idx;
        }
      });

      if (colIdx === -1) return;

      headers[colIdx].style.outline = "3px solid #e67e22";
      headers[colIdx].style.boxShadow = "0 0 10px rgba(230, 126, 34, 0.5)";

      document.querySelectorAll('#tableContainer tbody tr').forEach(row => {
        const cells = row.querySelectorAll('td');
        const td = cells[colIdx - 1]; 
        if (td) {
          td.style.outline = "3px solid #e67e22";
        }
      });
    }
  </script>
</body>
</html>
